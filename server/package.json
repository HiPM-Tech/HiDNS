{
    "name": "dnsmgr-server",
    "version": "2.1.4",
    "description": "DNS aggregation management platform backend",
    "license": "GPL-3.0",
    "main": "dist/app.js",
    "bin": "dist/app.js",
    "scripts": {
        "dev": "ts-node --files src/app.ts",
        "mcp": "ts-node --files src/mcp/start.ts",
        "build": "tsc && node scripts/copy-icons.js",
        "start": "node dist/app.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:init": "ts-node scripts/test-init.ts",
        "test:seed": "ts-node scripts/test-seed.ts",
        "test:verify-data": "ts-node scripts/test-verify-data.ts",
        "test:init-detect": "ts-node scripts/test-init-detect.ts",
        "test:concurrent": "ts-node scripts/test-concurrent.ts",
        "test:error-recovery": "ts-node scripts/test-error-recovery.ts",
        "db:migrate:test": "ts-node scripts/db-migrate.ts test",
        "db:rollback:test": "ts-node scripts/db-rollback.ts test",
        "db:migrate:ns-monitor": "node scripts/migrate-ns-monitor-fields.js",
        "cli": "ts-node src/cli.ts",
        "cli:help": "ts-node src/cli.ts --help",
        "embed:client": "node scripts/embed-client.mjs",
        "sea:build": "node scripts/build-sea.mjs",
        "sea:win": "node scripts/build-sea.mjs win",
        "sea:win-arm64": "node scripts/build-sea.mjs win-arm64",
        "sea:linux": "node scripts/build-sea.mjs linux",
        "sea:linux-arm64": "node scripts/build-sea.mjs linux-arm64",
        "sea:macos": "node scripts/build-sea.mjs macos",
        "sea:macos-x64": "node scripts/build-sea.mjs macos-x64",
        "sea:all": "node scripts/build-sea.mjs all"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@simplewebauthn/server": "^13.3.0",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.4.0",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "helmet": "^8.2.0",
        "https-proxy-agent": "^9.0.0",
        "jsonwebtoken": "^9.0.2",
        "mysql2": "^3.20.0",
        "otplib": "^12.0.1",
        "pg": "^8.20.0",
        "punycode.js": "^2.3.1",
        "qrcode": "^1.5.3",
        "socks-proxy-agent": "^10.0.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.0",
        "ws": "^8.20.0",
        "zod": "^4.4.3",
        "zxcvbn": "^4.4.2"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/node": "^20.19.39",
        "@types/pg": "^8.20.0",
        "@types/qrcode": "^1.5.6",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.6",
        "@types/ws": "^8.18.1",
        "esbuild": "^0.25.0",
        "postject": "^1.0.0-alpha.6",
        "rcedit": "^5.0.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3",
        "vitest": "^4.1.5"
    }
}
